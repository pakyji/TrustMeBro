# Copy this file to .env (git-ignored) and fill in your values.
# Never commit real keys. Never paste them in a public channel.

# Required: your Discord bot token (Developer Portal > Bot > Reset Token)
TOKEN=

# Optional AI providers. A command without its key replies with a "missing key" message.
GEMINI_API_KEY=
# Several Gemini keys can be comma-separated; one is picked at random per request.
OPENROUTER_API_KEY=
GROK_API_KEY=
BAZAAR_API_KEY=

# Optional model overrides. Free and hosted model names change, so check your provider's catalogue.
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free
GROK_MODEL=grok-4.3
BAZAAR_MODEL=qwen/qwen3.7-flash:free

# Optional: where warnings and anti-link settings are saved (default: data/store.json)
# STORE_PATH=/var/lib/trustmebro/store.json
